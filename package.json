{
  "name": "openauth-deployment",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client-sdk.ts",
    "./server": "./src/middleware/auth.ts"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "member": "node scripts/member.mjs",
    "dev": "wrangler dev",
    "check": "tsc --noEmit && wrangler deploy --dry-run",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply AUTH_DB --local",
    "migrate:remote": "wrangler d1 migrations apply AUTH_DB --remote"
  },
  "dependencies": { "better-auth": "1.7.6" },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260929.1",
    "esbuild": "0.28.1",
    "miniflare": "5.20260926.1-alpha",
    "typescript": "5.8.3",
    "wrangler": "4.143.1"
  }
}
